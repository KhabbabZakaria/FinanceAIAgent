# Market data and news sources
NEWSAPI_KEY=
FINNHUB_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fina/1.0 by u/yourname

# Hosted LLM fallback. Optional: with Ollama running, Fina works without it.
OPENAI_API_KEY=

# Email alerts from the background monitor. Gmail needs an App Password,
# not your account password (myaccount.google.com -> App passwords).
ALERT_EMAIL=
ALERT_EMAIL_PASSWORD=

# --- Optional overrides; defaults shown ---
# LLM_PROVIDERS=ollama,openai
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:3b
# OPENAI_MODEL=gpt-4o-mini
#
# Optional third tier: add 'groq' to LLM_PROVIDERS once this is set.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# QUESTION_RATE_LIMIT=10 per minute;200 per day
# ENABLE_MONITORING=1
# NEWS_ALERT_WINDOW_HOURS=1
# DB_PATH=portfolios.db
